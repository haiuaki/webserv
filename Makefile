# ════════════════════════════════════════════════════════════════════════════ #
#                           CONFIGURATION VARIABLES                            #
# ════════════════════════════════════════════════════════════════════════════ #

NAME		=	webserv

CXX			=	c++
CXXFLAGS	=	-Wall -Wextra -Werror -std=c++98 -I$(INCDIR)

INCDIR		=	include
SRCDIR		=	src
OBJDIR		=	obj

# ════════════════════════════════════════════════════════════════════════════ #
#                                 SOURCE FILES                                 #
# ════════════════════════════════════════════════════════════════════════════ #

SRCS		=	main.cpp

# ════════════════════════════════════════════════════════════════════════════ #
#                                 OBJECT FILES                                 #
# ════════════════════════════════════════════════════════════════════════════ #

OBJS		= $(addprefix $(OBJDIR)/, $(SRCS:.cpp=.o))

# ════════════════════════════════════════════════════════════════════════════ #
#                                PHONY TARGETS                                 #
# ════════════════════════════════════════════════════════════════════════════ #

.PHONY: all clean fclean re

# ════════════════════════════════════════════════════════════════════════════ #
#                                DEFAULT TARGET                                #
# ════════════════════════════════════════════════════════════════════════════ #

all: $(NAME)

# ════════════════════════════════════════════════════════════════════════════ #
#                                 BUILD RULES                                  #
# ════════════════════════════════════════════════════════════════════════════ #

$(OBJDIR)/%.o: $(SRCDIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(NAME): $(OBJS)
	@$(CXX) $(CXXFLAGS) $(OBJS) -o $@
	@echo "✓ $(NAME) created successfully"

# ════════════════════════════════════════════════════════════════════════════ #
#                                CLEANUP RULES                                 #
# ════════════════════════════════════════════════════════════════════════════ #

clean:
	rm -rf obj

fclean: clean
	rm -f $(NAME)

re: fclean all
